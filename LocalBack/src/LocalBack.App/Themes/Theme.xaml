<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:LocalBack.App.Controls">

    <!-- Tokens from design/README.md -->
    <FontFamily x:Key="UiFont">Segoe UI</FontFamily>
    <Color x:Key="AccentColor">#0F5FBF</Color>
    <SolidColorBrush x:Key="Text" Color="#1B1B1B"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#4A4A4A"/>
    <SolidColorBrush x:Key="TextMuted" Color="#5C5C5C"/>
    <SolidColorBrush x:Key="Surface" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Panel" Color="#F8F8F8"/>
    <SolidColorBrush x:Key="Panel2" Color="#F3F3F3"/>
    <SolidColorBrush x:Key="Border" Color="#E3E3E3"/>
    <SolidColorBrush x:Key="BorderStrong" Color="#C8C8C8"/>
    <SolidColorBrush x:Key="Divider" Color="#EFEFEF"/>
    <SolidColorBrush x:Key="Hover" Color="#ECECEC"/>
    <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentHover" Color="#0E58B1"/>
    <SolidColorBrush x:Key="AccentPressed" Color="#0B4A95"/>
    <SolidColorBrush x:Key="AccentDark" Color="#0B4A95"/>
    <SolidColorBrush x:Key="AccentTint" Color="#E6EEF9"/>
    <SolidColorBrush x:Key="AccentTintBorder" Color="#B9CDEB"/>
    <SolidColorBrush x:Key="AccentTintLight" Color="#F1F6FD"/>
    <SolidColorBrush x:Key="OutlineHover" Color="#EEF4FC"/>
    <SolidColorBrush x:Key="Green" Color="#1F7A4D"/>
    <SolidColorBrush x:Key="GreenTint" Color="#E3F1E8"/>
    <SolidColorBrush x:Key="GreenText" Color="#2E5A3F"/>
    <SolidColorBrush x:Key="Amber" Color="#B85C00"/>
    <SolidColorBrush x:Key="AmberTint" Color="#FBEEDF"/>
    <SolidColorBrush x:Key="Red" Color="#A12A2A"/>
    <SolidColorBrush x:Key="RedTint" Color="#F6E7E7"/>
    <SolidColorBrush x:Key="CloseHover" Color="#C42B1C"/>

    <!-- Line icons (24×24, stroked), copied from the design's SVGs -->
