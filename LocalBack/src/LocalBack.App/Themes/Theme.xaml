    <Geometry x:Key="IconFolder">M3,7 A2,2 0 0 1 5,5 H9 L11,7 H19 A2,2 0 0 1 21,9 V18 A2,2 0 0 1 19,20 H5 A2,2 0 0 1 3,18 Z</Geometry>
    <Geometry x:Key="IconClock">M3,12 A9,9 0 1 0 21,12 A9,9 0 1 0 3,12 Z M12,7 V12 L15,14</Geometry>
    <Geometry x:Key="IconDrive">M4,7 H20 A2,2 0 0 1 22,9 V15 A2,2 0 0 1 20,17 H4 A2,2 0 0 1 2,15 V9 A2,2 0 0 1 4,7 Z M15.5,12 A1.5,1.5 0 1 0 18.5,12 A1.5,1.5 0 1 0 15.5,12 Z M6,12 H12</Geometry>
