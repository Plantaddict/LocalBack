<Window x:Class="LocalBack.App.Views.TrayFlyout"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:LocalBack.App.Controls"
        xmlns:l="clr-namespace:LocalBack.App.Localization"
        Title="LocalBack" Width="376" Height="456" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="True"
        FontFamily="{StaticResource UiFont}" FontSize="14" Foreground="{StaticResource Text}" UseLayoutRounding="True">
    <Border Margin="8" CornerRadius="10" Background="{StaticResource Surface}" BorderBrush="{StaticResource BorderStrong}" BorderThickness="1" Padding="18">
        <Border.Effect>
            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.18"/>
        </Border.Effect>
        <DockPanel>
            <DockPanel DockPanel.Dock="Top">
                <Button DockPanel.Dock="Right" Style="{StaticResource BtnLinkSm}" Margin="0,0,-10,0" Command="{Binding OpenApp}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{l:T tray.openApp}"/>
                        <c:Icon Data="{StaticResource IconExternal}" Width="14" Height="14" Margin="6,0,0,0"/>
                    </StackPanel>
                </Button>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <c:Icon Data="{StaticResource IconLogo}" Width="18" Height="18" Foreground="{StaticResource Accent}"/>
                    <TextBlock Text="LocalBack" FontWeight="SemiBold" Margin="8,0,0,0"/>
                </StackPanel>
            </DockPanel>

            <Border DockPanel.Dock="Top" CornerRadius="8" Padding="14" Margin="0,14,0,0" Background="{Binding BannerBackground}">
                <DockPanel>
                    <c:Icon DockPanel.Dock="Left" Data="{Binding BannerIcon}" Width="26" Height="26" Foreground="{Binding BannerForeground}"/>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Headline}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{Binding BannerDetail}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <StackPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
                <Button Style="{StaticResource BtnPrimary}" Height="40" Command="{Binding BackUpNow}">
                    <StackPanel Orientation="Horizontal">
                        <c:Icon Data="{StaticResource IconBackUp}"/>
                        <TextBlock Text="{l:T tray.backUpNow}" Margin="8,0,0,0"/>
                    </StackPanel>
                </Button>
                <UniformGrid Columns="2" Margin="0,8,0,0">
                    <Button Style="{StaticResource BtnSecondary}" Content="{l:T tray.restore}" Command="{Binding Restore}" Margin="0,0,4,0"/>
                    <Button Style="{StaticResource BtnSecondary}" Content="{Binding PauseText}" Command="{Binding TogglePause}" Margin="4,0,0,0"/>
                </UniformGrid>
            </StackPanel>

            <ScrollViewer Margin="0,14,0,0" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Sets}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{StaticResource Divider}" BorderThickness="0,0,0,1" Padding="4,8" Margin="0,0,0,6">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding When}" Style="{StaticResource Secondary}" VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Style="{StaticResource Dot}" Fill="{Binding Dot}"/>
                                        <TextBlock Text="{Binding Name}" Margin="10,0,0,0" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
