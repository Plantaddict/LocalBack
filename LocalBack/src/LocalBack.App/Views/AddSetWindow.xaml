<v:DialogWindow x:Class="LocalBack.App.Views.AddSetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:LocalBack.App.Controls"
        xmlns:l="clr-namespace:LocalBack.App.Localization"
        xmlns:v="clr-namespace:LocalBack.App.Views"
        Title="{Binding Title}" Width="536" Height="836" Icon="pack://application:,,,/LocalBack;component/Assets/LocalBack.ico">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Vis"/>
    </Window.Resources>
    <Border Margin="8" CornerRadius="10" Background="{StaticResource Surface}" BorderBrush="{StaticResource BorderStrong}" BorderThickness="1" Padding="24">
        <Border.Effect>
            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.18"/>
        </Border.Effect>
        <DockPanel>
            <StackPanel DockPanel.Dock="Top">
                <TextBlock Text="{Binding Title}" Style="{StaticResource H2}"/>
                <TextBlock Text="{l:T addset.subtitle}" FontSize="13" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Buttons -->
            <StackPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
                <Border Background="{StaticResource RedTint}" CornerRadius="6" Padding="10,6" Margin="0,0,0,10" Visibility="{Binding HasError, Converter={StaticResource Vis}}">
                    <TextBlock Text="{Binding Error}" Foreground="{StaticResource Red}" FontSize="13" TextWrapping="Wrap"/>
                </Border>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource BtnSecondary}" Content="{l:T btn.cancel}" Command="{Binding Cancel}" IsCancel="True"/>
                    <Button Style="{StaticResource BtnPrimary}" Content="{Binding SubmitText}" Command="{Binding Create}" Margin="8,0,0,0" IsDefault="True"/>
                </StackPanel>
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,14,-12,0" Padding="0,0,12,0">
                <StackPanel>
                    <!-- Name -->
                    <TextBlock Text="{l:T addset.name}" Style="{StaticResource Label}"/>
                    <TextBox x:Name="NameBox" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{l:T addset.name}" PreviewKeyDown="NameBox_PreviewKeyDown"/>

                    <!-- Folders -->
                    <TextBlock Text="{l:T addset.folders}" Style="{StaticResource Label}" Margin="0,14,0,6"/>
                    <Border BorderBrush="{StaticResource BorderStrong}" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding Folders}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource Divider}" BorderThickness="0,0,0,1" Padding="10,4,4,4">
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Style="{StaticResource BtnIcon}" ToolTip="{l:T addset.removeFolder}" AutomationProperties.Name="{l:T addset.removeFolder}"
                                                        Command="{Binding DataContext.RemoveFolder, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                                    <c:Icon Data="{StaticResource IconClose}" Width="14" Height="14"/>
                                                </Button>
                                                <c:Icon DockPanel.Dock="Left" Data="{StaticResource IconFolder}" Foreground="{StaticResource TextSecondary}"/>
                                                <TextBlock Text="{Binding}" FontSize="13" Margin="8,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Style="{StaticResource BtnGhost}" Background="{StaticResource Panel}" Foreground="{StaticResource Accent}" FontWeight="SemiBold" FontSize="13"
                                    HorizontalContentAlignment="Left" Command="{Binding AddFolder}">
                                <StackPanel Orientation="Horizontal">
                                    <c:Icon Data="{StaticResource IconPlus}"/>
                                    <TextBlock Text="{l:T addset.addFolder}" Margin="8,0,0,0"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Destination + schedule -->
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,-2,-4,4">
                                    <Button Style="{StaticResource BtnLinkSm}" Height="20" Padding="4,0" Content="{l:T addset.browse}" Command="{Binding BrowseDestination}" FontSize="12"/>
                                    <Button Style="{StaticResource BtnLinkSm}" Height="20" Padding="4,0" Content="{l:T btn.refresh}" Command="{Binding RefreshDrives}" FontSize="12"/>
                                </StackPanel>
                                <TextBlock Text="{l:T addset.destination}" Style="{StaticResource Label}"/>
                            </DockPanel>
                            <ComboBox ItemsSource="{Binding Drives}" SelectedItem="{Binding SelectedDrive}" DisplayMemberPath="Text"
                                      IsEnabled="{Binding IsEditing, Converter={x:Static v:Converters.Not}}" AutomationProperties.Name="{l:T addset.destination}"/>
                            <TextBlock Text="{l:T addset.noDrives}" Style="{StaticResource Secondary}" Margin="0,4,0,0" TextWrapping="Wrap"
                                       Visibility="{Binding NoDrives, Converter={StaticResource Vis}}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{l:T addset.run}" Style="{StaticResource Label}"/>
                            <ComboBox ItemsSource="{Binding Schedules}" SelectedItem="{Binding SelectedSchedule}" DisplayMemberPath="Text" AutomationProperties.Name="{l:T addset.run}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Password: offered for a new destination; asked for a locked one -->
                    <StackPanel Margin="0,10,0,0">
                        <TextBlock Text="{Binding DestinationNote}" Style="{StaticResource Secondary}" TextWrapping="Wrap"
                                   Visibility="{Binding HasDestinationNote, Converter={StaticResource Vis}}"/>
                        <CheckBox IsChecked="{Binding Protect}" Visibility="{Binding ShowProtect, Converter={StaticResource Vis}}">
                            <TextBlock Text="{l:T addset.password.protect}"/>
                        </CheckBox>
                        <StackPanel Visibility="{Binding ShowPasswordFields, Converter={StaticResource Vis}}" Margin="0,8,0,0">
                            <TextBlock Text="{l:T addset.password.hint}" Style="{StaticResource Secondary}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{l:T addset.password}" Style="{StaticResource Label}"/>
                                    <PasswordBox x:Name="PasswordBox1" Height="34" Padding="8,6" FontSize="14" BorderBrush="{StaticResource BorderStrong}" PasswordChanged="Password_Changed"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{l:T addset.password.repeat}" Style="{StaticResource Label}"/>
                                    <PasswordBox x:Name="PasswordBox2" Height="34" Padding="8,6" FontSize="14" BorderBrush="{StaticResource BorderStrong}" PasswordChanged="Password_Changed"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                        <StackPanel Visibility="{Binding ShowUnlock, Converter={StaticResource Vis}}" Margin="0,6,0,0">
                            <TextBlock Text="{l:T addset.password}" Style="{StaticResource Label}"/>
                            <PasswordBox x:Name="PasswordBox3" Height="34" Padding="8,6" FontSize="14" BorderBrush="{StaticResource BorderStrong}" PasswordChanged="Password_Changed"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Exclusions -->
                    <DockPanel Margin="0,14,0,8">
                        <TextBlock DockPanel.Dock="Left" Text="{l:T addset.exclude}" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding RulesSummary}" Style="{StaticResource Secondary}" TextAlignment="Right" TextTrimming="CharacterEllipsis" Margin="12,1,0,0"/>
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Rules}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding Toggle}" Margin="0,0,6,6" Cursor="Hand" FocusVisualStyle="{StaticResource FocusRing}"
                                        AutomationProperties.Name="{Binding Title}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Height="40" Padding="10,0" CornerRadius="6" BorderThickness="1" BorderBrush="{Binding Border}" Background="{Binding Background}">
                                                <DockPanel>
                                                    <Border DockPanel.Dock="Left" Width="18" Height="18" CornerRadius="4" BorderThickness="1"
                                                            BorderBrush="{Binding BoxBorder}" Background="{Binding BoxBackground}">
                                                        <c:Icon Data="{StaticResource IconCheck}" Width="12" Height="12" Foreground="White" StrokeWidth="3"
                                                                HorizontalAlignment="Center" Visibility="{Binding IsOn, Converter={StaticResource Vis}}"/>
                                                    </Border>
                                                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Patterns}" FontSize="11" Foreground="{StaticResource TextSecondary}" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ItemsControl ItemsSource="{Binding CustomPatterns}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource AccentTintLight}" BorderBrush="{StaticResource AccentTintBorder}" BorderThickness="1"
                                        CornerRadius="12" Padding="10,0,2,0" Margin="0,0,6,6" Height="26">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding}" FontSize="12" VerticalAlignment="Center"/>
                                        <Button Style="{StaticResource BtnIcon}" Width="22" Height="22" Margin="2,0,0,0"
                                                Command="{Binding DataContext.RemovePattern, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                            <c:Icon Data="{StaticResource IconClose}" Width="10" Height="10"/>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource BtnSecondarySm}" Height="34" Content="{l:T addset.add}" Command="{Binding AddPattern}" Margin="6,0,0,0"/>
                        <TextBox Tag="{l:T addset.customPlaceholder}" FontSize="13" Text="{Binding CustomPattern, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="{l:T addset.customPlaceholder}" KeyDown="Pattern_KeyDown"/>
                    </DockPanel>

                    <CheckBox IsChecked="{Binding KeepHistory}" Margin="0,14,0,0"><TextBlock Text="{l:T addset.keepHistory}" TextWrapping="Wrap"/></CheckBox>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</v:DialogWindow>
