<v:DialogWindow x:Class="LocalBack.App.Views.AddSetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:LocalBack.App.Controls"
        xmlns:v="clr-namespace:LocalBack.App.Views"
        Title="{Binding Title}" Width="536" Height="816" Icon="/Assets/LocalBack.ico">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Vis"/>
    </Window.Resources>
    <Border Margin="8" CornerRadius="10" Background="{StaticResource Surface}" BorderBrush="{StaticResource BorderStrong}" BorderThickness="1" Padding="24">
        <Border.Effect>
            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.18"/>
        </Border.Effect>
        <DockPanel>
            <StackPanel DockPanel.Dock="Top">
                <TextBlock Text="{Binding Title}" Style="{StaticResource H2}"/>
                <TextBlock Text="Pick the folders to protect and where to keep them." FontSize="13" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Buttons -->
            <StackPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
                <Border Background="{StaticResource RedTint}" CornerRadius="6" Padding="10,6" Margin="0,0,0,10" Visibility="{Binding HasError, Converter={StaticResource Vis}}">
                    <TextBlock Text="{Binding Error}" Foreground="{StaticResource Red}" FontSize="13" TextWrapping="Wrap"/>
                </Border>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource BtnSecondary}" Content="Cancel" Command="{Binding Cancel}" IsCancel="True"/>
                    <Button Style="{StaticResource BtnPrimary}" Content="{Binding SubmitText}" Command="{Binding Create}" Margin="8,0,0,0" IsDefault="True"/>
                </StackPanel>
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,14,-12,0" Padding="0,0,12,0">
                <StackPanel>
                    <!-- Name -->
                    <TextBlock Text="Name" Style="{StaticResource Label}"/>
                    <TextBox x:Name="NameBox" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Name" PreviewKeyDown="NameBox_PreviewKeyDown"/>

                    <!-- Folders -->
                    <TextBlock Text="Folders" Style="{StaticResource Label}" Margin="0,14,0,6"/>
                    <Border BorderBrush="{StaticResource BorderStrong}" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding Folders}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource Divider}" BorderThickness="0,0,0,1" Padding="10,4,4,4">
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Style="{StaticResource BtnIcon}" ToolTip="Remove folder" AutomationProperties.Name="Remove folder"
                                                        Command="{Binding DataContext.RemoveFolder, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                                    <c:Icon Data="{StaticResource IconClose}" Width="14" Height="14"/>
                                                </Button>
                                                <c:Icon DockPanel.Dock="Left" Data="{StaticResource IconFolder}" Foreground="{StaticResource TextSecondary}"/>
                                                <TextBlock Text="{Binding}" FontSize="13" Margin="8,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Style="{StaticResource BtnGhost}" Background="{StaticResource Panel}" Foreground="{StaticResource Accent}" FontWeight="SemiBold" FontSize="13"
                                    HorizontalContentAlignment="Left" Command="{Binding AddFolder}">
                                <StackPanel Orientation="Horizontal">
                                    <c:Icon Data="{StaticResource IconPlus}"/>
                                    <TextBlock Text="Add folder…" Margin="8,0,0,0"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Drive + schedule -->
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource BtnLinkSm}" Height="20" Padding="4,0" Margin="0,-2,-4,4" Content="Refresh"
                                        Command="{Binding RefreshDrives}" FontSize="12"/>
                                <TextBlock Text="Backup drive" Style="{StaticResource Label}"/>
                            </DockPanel>
                            <ComboBox ItemsSource="{Binding Drives}" SelectedItem="{Binding SelectedDrive}" DisplayMemberPath="Text"
                                      IsEnabled="{Binding IsEditing, Converter={x:Static v:Converters.Not}}" AutomationProperties.Name="Backup drive"/>
                            <TextBlock Text="Plug in a USB drive or external disk." Style="{StaticResource Secondary}" Margin="0,4,0,0"
                                       Visibility="{Binding NoDrives, Converter={StaticResource Vis}}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Run" Style="{StaticResource Label}"/>
                            <ComboBox ItemsSource="{Binding Schedules}" SelectedItem="{Binding SelectedSchedule}" DisplayMemberPath="Text" AutomationProperties.Name="Run"/>
                        </StackPanel>
                    </Grid>

                    <!-- Exclusions -->
                    <DockPanel Margin="0,14,0,8">
                        <TextBlock DockPanel.Dock="Left" Text="Exclude" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding RulesSummary}" Style="{StaticResource Secondary}" TextAlignment="Right" TextTrimming="CharacterEllipsis" Margin="12,1,0,0"/>
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Rules}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding Toggle}" Margin="0,0,6,6" Cursor="Hand" FocusVisualStyle="{StaticResource FocusRing}"
                                        AutomationProperties.Name="{Binding Title}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Height="40" Padding="10,0" CornerRadius="6" BorderThickness="1" BorderBrush="{Binding Border}" Background="{Binding Background}">
                                                <DockPanel>
                                                    <Border DockPanel.Dock="Left" Width="18" Height="18" CornerRadius="4" BorderThickness="1"
                                                            BorderBrush="{Binding BoxBorder}" Background="{Binding BoxBackground}">
                                                        <c:Icon Data="{StaticResource IconCheck}" Width="12" Height="12" Foreground="White" StrokeWidth="3"
                                                                HorizontalAlignment="Center" Visibility="{Binding IsOn, Converter={StaticResource Vis}}"/>
                                                    </Border>
                                                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="Medium"/>
                                                        <TextBlock Text="{Binding Patterns}" FontSize="11" Foreground="{StaticResource TextSecondary}" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ItemsControl ItemsSource="{Binding CustomPatterns}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource AccentTintLight}" BorderBrush="{StaticResource AccentTintBorder}" BorderThickness="1"
                                        CornerRadius="12" Padding="10,0,2,0" Margin="0,0,6,6" Height="26">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding}" FontSize="12" VerticalAlignment="Center"/>
                                        <Button Style="{StaticResource BtnIcon}" Width="22" Height="22" Margin="2,0,0,0" ToolTip="Remove pattern"
                                                Command="{Binding DataContext.RemovePattern, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                            <c:Icon Data="{StaticResource IconClose}" Width="10" Height="10"/>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource BtnSecondarySm}" Height="34" Content="Add" Command="{Binding AddPattern}" Margin="6,0,0,0"/>
                        <TextBox Tag="Custom pattern, e.g. *.iso or Renders/" FontSize="13" Text="{Binding CustomPattern, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Custom pattern" KeyDown="Pattern_KeyDown"/>
                    </DockPanel>

                    <CheckBox Content="Keep version history (older copies of changed files)" IsChecked="{Binding KeepHistory}" Margin="0,14,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</v:DialogWindow>
