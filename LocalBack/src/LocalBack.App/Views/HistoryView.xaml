<UserControl x:Class="LocalBack.App.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:LocalBack.App.Controls"
             xmlns:l="clr-namespace:LocalBack.App.Localization"
             xmlns:v="clr-namespace:LocalBack.App.Views">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Vis"/>
        <Style x:Key="PlainList" TargetType="ListBox">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Focusable" Value="False"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- "Changes | Folders" view switch -->
        <Style x:Key="Segment" TargetType="RadioButton">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Hover}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="White"/>
                                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Snapshots -->
        <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="16,16,16,10">
                    <Button Style="{StaticResource BtnLinkSm}" HorizontalAlignment="Left" Margin="-10,0,0,10" Command="{Binding Back}">
                        <StackPanel Orientation="Horizontal">
                            <c:Icon Data="{StaticResource IconBack}" Width="14" Height="14"/>
                            <TextBlock Text="{l:T history.back}" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <TextBlock Text="{l:T history.set}" Style="{StaticResource Secondary}" Margin="0,0,0,6"/>
                    <ComboBox ItemsSource="{Binding Sets}" SelectedItem="{Binding SelectedSet}" DisplayMemberPath="Name" AutomationProperties.Name="{l:T history.set}"/>
                </StackPanel>
                <TextBlock DockPanel.Dock="Top" Text="{l:T history.snapshots}" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="24,0,0,4"/>
                <ListBox Style="{StaticResource PlainList}" ItemsSource="{Binding Snapshots}" Margin="8,0,8,12">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Button Command="{Binding Pick}" Cursor="Hand" Margin="0,0,0,2" FocusVisualStyle="{StaticResource FocusRing}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" CornerRadius="6" Padding="10" Background="{Binding Background}">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Size}" Style="{StaticResource Secondary}" VerticalAlignment="Center"/>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Label}" FontWeight="{Binding Weight}"/>
                                                    <TextBlock Text="{Binding Meta}" Style="{StaticResource Secondary}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource TemplatedParent}}" Value="True"/>
                                                    <Condition Binding="{Binding IsSelected}" Value="False"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Hover}"/>
                                            </MultiDataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Files of the chosen snapshot -->
        <DockPanel Grid.Column="1">
            <Border DockPanel.Dock="Top" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="24,20,24,14">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0"
                                Visibility="{Binding ShowDeleted, Converter={x:Static v:Converters.NotVis}}">
                        <Button Style="{StaticResource BtnSecondary}" Command="{Binding RestoreToFolder}">
                            <StackPanel Orientation="Horizontal">
                                <c:Icon Data="{StaticResource IconFolder}"/>
                                <TextBlock Text="{l:T history.restoreToFolder}" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource BtnPrimary}" Command="{Binding RestoreEverything}" Margin="8,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <c:Icon Data="{StaticResource IconRestore}"/>
                                <TextBlock Text="{l:T history.restoreEverything}" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="{Binding Header}" Style="{StaticResource H2}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding SubHeader}" Foreground="{StaticResource TextSecondary}" FontSize="13" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border DockPanel.Dock="Top" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="24,10">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="10,0,0,0">
                        <Border Background="{StaticResource Panel2}" CornerRadius="6" Padding="2" VerticalAlignment="Center"
                                Visibility="{Binding ShowDeleted, Converter={x:Static v:Converters.NotVis}}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource Segment}" GroupName="historyView" IsChecked="{Binding BrowseFolders, Converter={x:Static v:Converters.Not}}"
                                             AutomationProperties.Name="{l:T browse.changes}">
                                    <StackPanel Orientation="Horizontal">
                                        <c:Icon Data="{StaticResource IconList}" Width="14" Height="14"/>
                                        <TextBlock Text="{l:T browse.changes}" Margin="6,0,0,0"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton Style="{StaticResource Segment}" GroupName="historyView" IsChecked="{Binding BrowseFolders}"
                                             AutomationProperties.Name="{l:T browse.folders}">
                                    <StackPanel Orientation="Horizontal">
                                        <c:Icon Data="{StaticResource IconFolder}" Width="14" Height="14"/>
                                        <TextBlock Text="{l:T browse.folders}" Margin="6,0,0,0"/>
                                    </StackPanel>
                                </RadioButton>
                            </StackPanel>
                        </Border>
                        <CheckBox IsChecked="{Binding OnlyChanged}" Foreground="{StaticResource TextSecondary}" Margin="14,0,0,0"
                                  IsEnabled="{Binding ShowDeleted, Converter={x:Static v:Converters.Not}}"
                                  Visibility="{Binding ShowList, Converter={StaticResource Vis}}">
                            <TextBlock Text="{l:T history.onlyChanged}"/>
                        </CheckBox>
                        <CheckBox IsChecked="{Binding ShowDeleted}" Foreground="{StaticResource TextSecondary}" Margin="14,0,0,0">
                            <TextBlock Text="{l:T history.deleted}"/>
                        </CheckBox>
                    </StackPanel>
                    <TextBox Height="32" Tag="{l:T history.search}" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                             AutomationProperties.Name="{l:T history.search}"/>
                </DockPanel>
            </Border>

            <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="24,10">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding SourceText}" Style="{StaticResource Secondary}" Margin="16,0,0,0" TextTrimming="CharacterEllipsis" MaxWidth="260"/>
                    <TextBlock Text="{Binding FooterText}" Style="{StaticResource Secondary}" TextWrapping="Wrap"/>
                </DockPanel>
            </Border>

            <Grid>
                <!-- Changes: flat list of the snapshot's files -->
                <Grid Margin="24,6,24,12" Visibility="{Binding ShowList, Converter={StaticResource Vis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="10,8" TextElement.FontSize="11" TextElement.Foreground="{StaticResource TextSecondary}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="190"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{l:T history.col.file}"/>
                        <TextBlock Grid.Column="1" Text="{l:T history.col.size}" Margin="12,0,0,0"/>
                        <TextBlock Grid.Column="2" Text="{l:T history.col.change}" Margin="12,0,0,0"/>
                    </Grid>

                    <ListBox Grid.Row="1" Style="{StaticResource PlainList}" ItemsSource="{Binding Files}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource Divider}" BorderThickness="0,1,0,0" Padding="10,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="190"/>
                                        </Grid.ColumnDefinitions>
                                        <DockPanel ToolTip="{Binding FullPath}">
                                            <c:Icon DockPanel.Dock="Left" Data="{StaticResource IconFile}" Foreground="{StaticResource TextSecondary}"/>
                                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Secondary}" TextTrimming="CharacterEllipsis"
                                                           Visibility="{Binding HasDetail, Converter={StaticResource Vis}}"/>
                                            </StackPanel>
                                        </DockPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding Size}" FontSize="13" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                        <Border Grid.Column="2" CornerRadius="10" Padding="8,2" Background="{Binding TagBackground}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0" MaxWidth="88">
                                            <TextBlock Text="{Binding Change}" FontSize="12" Foreground="{Binding TagForeground}" TextTrimming="CharacterEllipsis"/>
                                        </Border>
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Style="{StaticResource BtnSecondarySm}" Content="{l:T history.open}" Command="{Binding Open}"/>
                                            <Button Style="{StaticResource BtnOutlineSm}" Content="{Binding RestoreText}" Command="{Binding Restore}" Margin="6,0,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Grid.Row="1" Text="{Binding EmptyFilesText}" Foreground="{StaticResource TextSecondary}" Margin="10,16" TextWrapping="Wrap"
                               Visibility="{Binding FilesEmpty, Converter={StaticResource Vis}}"/>
                </Grid>

                <!-- Folders: browse the snapshot like a drive in Explorer -->
                <Grid Margin="24,10,24,8" Visibility="{Binding ShowBrowser, Converter={StaticResource Vis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Address bar -->
                    <DockPanel Margin="0,0,0,8">
                        <Button Style="{StaticResource BtnIcon}" Command="{Binding Browser.Back}" ToolTip="{l:T browse.back}" AutomationProperties.Name="{l:T browse.back}">
                            <c:Icon Data="{StaticResource IconBack}"/>
                        </Button>
                        <Button Style="{StaticResource BtnIcon}" Command="{Binding Browser.Forward}" ToolTip="{l:T browse.forward}" AutomationProperties.Name="{l:T browse.forward}">
                            <c:Icon Data="{StaticResource IconForward}"/>
                        </Button>
                        <Button Style="{StaticResource BtnIcon}" Command="{Binding Browser.Up}" ToolTip="{l:T browse.up}" AutomationProperties.Name="{l:T browse.up}">
                            <c:Icon Data="{StaticResource IconUp}"/>
                        </Button>
                        <Border Background="White" BorderBrush="{StaticResource BorderStrong}" BorderThickness="1" CornerRadius="6" Height="32" Margin="6,0,0,0"
                                ToolTip="{Binding Browser.AddressText}">
                            <DockPanel>
                                <c:Icon DockPanel.Dock="Left" Data="{StaticResource IconFolder}" Foreground="{StaticResource TextSecondary}" Margin="8,0,2,0"/>
                                <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" VerticalAlignment="Center">
                                    <ItemsControl ItemsSource="{Binding Browser.Crumbs}" Focusable="False">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Style="{StaticResource BtnGhostSm}" Height="24" Padding="6,0" FontWeight="{Binding Weight}" Content="{Binding Name}" Command="{Binding Go}"/>
                                                    <TextBlock Text="›" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="1,0"
                                                               Visibility="{Binding IsLast, Converter={x:Static v:Converters.NotVis}}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                    </DockPanel>

                    <!-- Details list -->
                    <ListView x:Name="FolderList" Grid.Row="1" ItemsSource="{Binding Browser.Items}" SelectedItem="{Binding Browser.SelectedItem}"
                              SelectionMode="Extended" BorderThickness="1" BorderBrush="{StaticResource Border}" Background="White" FontSize="13"
                              VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              SelectionChanged="FolderList_SelectionChanged" KeyDown="FolderList_KeyDown" SizeChanged="FolderList_SizeChanged"
                              GridViewColumnHeader.Click="FolderList_HeaderClick" AutomationProperties.Name="{l:T browse.folders}">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="4,3"/>
                                <Setter Property="ToolTip" Value="{Binding Tooltip}"/>
                                <EventSetter Event="MouseDoubleClick" Handler="FolderItem_DoubleClick"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{l:T browse.open}" Command="{Binding Browser.OpenSelected}" FontWeight="SemiBold"/>
                                <Separator/>
                                <MenuItem Header="{l:T history.restore}" Command="{Binding Browser.RestoreSelected}"/>
                                <MenuItem Header="{l:T browse.restoreTo}" Command="{Binding Browser.RestoreSelectedTo}"/>
                            </ContextMenu>
                        </ListView.ContextMenu>
                        <ListView.View>
                            <GridView>
                                <GridViewColumn x:Name="NameColumn" Width="260">
                                    <GridViewColumn.Header>
                                        <GridViewColumnHeader Content="{l:T browse.col.name}" Tag="Name" HorizontalContentAlignment="Left" Padding="8,4"/>
                                    </GridViewColumn.Header>
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <DockPanel>
                                                <Grid DockPanel.Dock="Left" Width="16" Height="16" VerticalAlignment="Center">
                                                    <Image Source="{Binding Icon}" RenderOptions.BitmapScalingMode="HighQuality"
                                                           Visibility="{Binding HasIcon, Converter={StaticResource Vis}}"/>
                                                    <c:Icon Data="{Binding FallbackIcon}" Foreground="{StaticResource TextSecondary}"
                                                            Visibility="{Binding HasIcon, Converter={x:Static v:Converters.NotVis}}"/>
                                                </Grid>
                                                <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                                    <Run Text="{Binding Name, Mode=OneWay}"/><Run Text="{Binding LocationText, Mode=OneWay}" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                                                </TextBlock>
                                            </DockPanel>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn x:Name="ModifiedColumn" Width="130" DisplayMemberBinding="{Binding Modified}">
                                    <GridViewColumn.Header>
                                        <GridViewColumnHeader Content="{l:T browse.col.modified}" Tag="Modified" HorizontalContentAlignment="Left" Padding="8,4"/>
                                    </GridViewColumn.Header>
                                </GridViewColumn>
                                <GridViewColumn x:Name="TypeColumn" Width="130" DisplayMemberBinding="{Binding TypeName}">
                                    <GridViewColumn.Header>
                                        <GridViewColumnHeader Content="{l:T browse.col.type}" Tag="Type" HorizontalContentAlignment="Left" Padding="8,4"/>
                                    </GridViewColumn.Header>
                                </GridViewColumn>
                                <GridViewColumn x:Name="SizeColumn" Width="84">
                                    <GridViewColumn.Header>
                                        <GridViewColumnHeader Content="{l:T browse.col.size}" Tag="Size" HorizontalContentAlignment="Right" Padding="8,4"/>
                                    </GridViewColumn.Header>
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Size}" HorizontalAlignment="Right" Margin="0,0,4,0"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn x:Name="ChangeColumn" Width="96">
                                    <GridViewColumn.Header>
                                        <GridViewColumnHeader Content="{l:T browse.col.change}" Tag="Change" HorizontalContentAlignment="Left" Padding="8,4"/>
                                    </GridViewColumn.Header>
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Change}" Foreground="{Binding ChangeForeground}" FontSize="12"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                    <TextBlock Grid.Row="1" Text="{Binding Browser.EmptyText}" Foreground="{StaticResource TextSecondary}" Margin="12,40,12,0" TextWrapping="Wrap"
                               IsHitTestVisible="False" Visibility="{Binding Browser.IsEmpty, Converter={StaticResource Vis}}"/>

                    <!-- Status strip, like Explorer's -->
                    <TextBlock Grid.Row="2" Text="{Binding Browser.StatusText}" Style="{StaticResource Secondary}" Margin="4,6,0,0"/>
                </Grid>

                <ProgressBar Height="2" IsIndeterminate="True" VerticalAlignment="Top" Margin="24,0" BorderThickness="0" Background="Transparent"
                             Foreground="{StaticResource Accent}" Visibility="{Binding Loading, Converter={StaticResource Vis}}"/>
            </Grid>
        </DockPanel>

        <!-- Message overlay: drive missing, locked, no snapshots, file not in a set -->
        <Border Grid.Column="1" Background="{StaticResource Surface}" Visibility="{Binding HasMessage, Converter={StaticResource Vis}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420">
                <c:Icon Data="{StaticResource IconDrive}" Width="36" Height="36" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,12,0,0" Foreground="{StaticResource TextSecondary}"/>
                <Button Style="{StaticResource BtnPrimary}" Content="{l:T history.unlockButton}" Command="{Binding UnlockCommand}" HorizontalAlignment="Center" Margin="0,16,0,0"
                        Visibility="{Binding ShowUnlock, Converter={StaticResource Vis}}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
