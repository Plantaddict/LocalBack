<UserControl x:Class="LocalBack.App.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:LocalBack.App.Controls">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Vis"/>
        <Style x:Key="PlainList" TargetType="ListBox">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Focusable" Value="False"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Snapshots -->
        <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="16,16,16,10">
                    <Button Style="{StaticResource BtnLinkSm}" HorizontalAlignment="Left" Margin="-10,0,0,10" Command="{Binding Back}">
                        <StackPanel Orientation="Horizontal">
                            <c:Icon Data="{StaticResource IconBack}" Width="14" Height="14"/>
                            <TextBlock Text="Backup sets" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <TextBlock Text="Backup set" Style="{StaticResource Secondary}" Margin="0,0,0,6"/>
                    <ComboBox ItemsSource="{Binding Sets}" SelectedItem="{Binding SelectedSet}" DisplayMemberPath="Name" AutomationProperties.Name="Backup set"/>
                </StackPanel>
                <TextBlock DockPanel.Dock="Top" Text="SNAPSHOTS" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="24,0,0,4"/>
                <ListBox Style="{StaticResource PlainList}" ItemsSource="{Binding Snapshots}" Margin="8,0,8,12">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Button Command="{Binding Pick}" Cursor="Hand" Margin="0,0,0,2" FocusVisualStyle="{StaticResource FocusRing}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" CornerRadius="6" Padding="10" Background="{Binding Background}">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Size}" Style="{StaticResource Secondary}" VerticalAlignment="Center"/>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Label}" FontWeight="{Binding Weight}"/>
                                                    <TextBlock Text="{Binding Meta}" Style="{StaticResource Secondary}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource TemplatedParent}}" Value="True"/>
                                                    <Condition Binding="{Binding IsSelected}" Value="False"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Hover}"/>
                                            </MultiDataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Files of the chosen snapshot -->
        <DockPanel Grid.Column="1">
            <Border DockPanel.Dock="Top" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="24,20,24,14">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                        <Button Style="{StaticResource BtnSecondary}" Command="{Binding RestoreToFolder}">
                            <StackPanel Orientation="Horizontal">
                                <c:Icon Data="{StaticResource IconFolder}"/>
                                <TextBlock Text="Restore to folder…" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource BtnPrimary}" Command="{Binding RestoreEverything}" Margin="8,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <c:Icon Data="{StaticResource IconRestore}"/>
                                <TextBlock Text="Restore everything" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="{Binding Header}" Style="{StaticResource H2}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding SubHeader}" Foreground="{StaticResource TextSecondary}" FontSize="13" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border DockPanel.Dock="Top" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="24,10">
                <DockPanel>
                    <CheckBox DockPanel.Dock="Right" Content="Only changed in this snapshot" IsChecked="{Binding OnlyChanged}" Margin="10,0,0,0"
                              Foreground="{StaticResource TextSecondary}"/>
                    <TextBox Height="32" Tag="Search files in this snapshot" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                             AutomationProperties.Name="Search files"/>
                </DockPanel>
            </Border>

            <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="24,10">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding SourceText}" Style="{StaticResource Secondary}" Margin="16,0,0,0" TextTrimming="CharacterEllipsis" MaxWidth="260"/>
                    <TextBlock Text="{Binding FooterText}" Style="{StaticResource Secondary}" TextWrapping="Wrap"/>
                </DockPanel>
            </Border>

            <Grid Margin="24,6,24,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Margin="10,8" TextElement.FontSize="11" TextElement.Foreground="{StaticResource TextSecondary}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="190"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="FILE"/>
                    <TextBlock Grid.Column="1" Text="SIZE" Margin="12,0,0,0"/>
                    <TextBlock Grid.Column="2" Text="CHANGE" Margin="12,0,0,0"/>
                </Grid>

                <ListBox Grid.Row="1" Style="{StaticResource PlainList}" ItemsSource="{Binding Files}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{StaticResource Divider}" BorderThickness="0,1,0,0" Padding="10,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="190"/>
                                    </Grid.ColumnDefinitions>
                                    <DockPanel ToolTip="{Binding FullPath}">
                                        <c:Icon DockPanel.Dock="Left" Data="{StaticResource IconFile}" Foreground="{StaticResource TextSecondary}"/>
                                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Folder}" Style="{StaticResource Secondary}" TextTrimming="CharacterEllipsis"
                                                       Visibility="{Binding HasFolder, Converter={StaticResource Vis}}"/>
                                        </StackPanel>
                                    </DockPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding Size}" FontSize="13" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                    <Border Grid.Column="2" CornerRadius="10" Padding="8,2" Background="{Binding TagBackground}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0">
                                        <TextBlock Text="{Binding Change}" FontSize="12" Foreground="{Binding TagForeground}"/>
                                    </Border>
                                    <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Style="{StaticResource BtnSecondarySm}" Content="Open" Command="{Binding Open}"/>
                                        <Button Style="{StaticResource BtnOutlineSm}" Content="{Binding RestoreText}" Command="{Binding Restore}" Margin="6,0,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Grid.Row="1" Text="{Binding EmptyFilesText}" Foreground="{StaticResource TextSecondary}" Margin="10,16" TextWrapping="Wrap"
                           Visibility="{Binding FilesEmpty, Converter={StaticResource Vis}}"/>
                <ProgressBar Grid.Row="0" Height="2" IsIndeterminate="True" VerticalAlignment="Bottom" BorderThickness="0" Background="Transparent"
                             Foreground="{StaticResource Accent}" Visibility="{Binding Loading, Converter={StaticResource Vis}}"/>
            </Grid>
        </DockPanel>

        <!-- Message overlay: drive missing, no snapshots, file not in a set -->
        <Border Grid.Column="1" Background="{StaticResource Surface}" Visibility="{Binding HasMessage, Converter={StaticResource Vis}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420">
                <c:Icon Data="{StaticResource IconDrive}" Width="36" Height="36" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,12,0,0" Foreground="{StaticResource TextSecondary}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
