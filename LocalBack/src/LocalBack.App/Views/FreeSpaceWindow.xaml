<v:DialogWindow x:Class="LocalBack.App.Views.FreeSpaceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:LocalBack.App.Controls"
        xmlns:l="clr-namespace:LocalBack.App.Localization"
        xmlns:v="clr-namespace:LocalBack.App.Views"
        Title="{l:T free.doneTitle}" Width="536" Height="616" Icon="pack://application:,,,/LocalBack;component/Assets/LocalBack.ico" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Vis"/>
    </Window.Resources>
    <Border Margin="8" CornerRadius="10" Background="{StaticResource Surface}" BorderBrush="{StaticResource BorderStrong}" BorderThickness="1" Padding="24">
        <Border.Effect>
            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.18"/>
        </Border.Effect>
        <DockPanel>
            <DockPanel DockPanel.Dock="Top">
                <c:Icon DockPanel.Dock="Left" Data="{StaticResource IconWarning}" Width="28" Height="28" Foreground="{StaticResource Amber}" VerticalAlignment="Top"/>
                <StackPanel Margin="12,0,0,0">
                    <TextBlock Text="{Binding Title}" Style="{StaticResource H2}" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Summary}" FontSize="13" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </DockPanel>

            <!-- Usage bar: current files vs older versions -->
            <StackPanel DockPanel.Dock="Top" Margin="0,16,0,0">
                <Border Height="8" CornerRadius="4" Background="{StaticResource Border}" ClipToBounds="True">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{Binding CurrentPercent, Converter={x:Static v:Converters.Star}}"/>
                            <ColumnDefinition Width="{Binding OlderPercent, Converter={x:Static v:Converters.Star}}"/>
                            <ColumnDefinition Width="{Binding FreePercent, RelativeSource={RelativeSource AncestorType=v:FreeSpaceWindow}, Converter={x:Static v:Converters.Star}}"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="{StaticResource Accent}"/>
                        <Border Grid.Column="1" Background="{StaticResource Amber}"/>
                    </Grid>
                </Border>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2" Fill="{StaticResource Accent}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding CurrentText}" Style="{StaticResource Secondary}" Margin="6,0,18,0"/>
                    <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2" Fill="{StaticResource Amber}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding OlderText}" Style="{StaticResource Secondary}" Margin="6,0,0,0"/>
                </StackPanel>
            </StackPanel>

            <!-- Footer -->
            <DockPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource BtnSecondary}" Content="{l:T free.notNow}" Command="{Binding NotNow}"/>
                    <Button Style="{StaticResource BtnPrimary}" Content="{Binding ApplyText}" Command="{Binding Apply}" Margin="8,0,0,0"/>
                </StackPanel>
                <CheckBox IsChecked="{Binding AutoFree}" VerticalAlignment="Center" Margin="0,0,8,0">
                    <TextBlock Text="{l:T free.auto}" TextWrapping="Wrap"/>
                </CheckBox>
            </DockPanel>

            <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                <TextBlock Text="{l:T free.keptNote}" Style="{StaticResource Secondary}" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding Offenders}" Style="{StaticResource Secondary}" TextWrapping="Wrap" Margin="0,4,0,0"
                           Visibility="{Binding HasOffenders, Converter={StaticResource Vis}}"/>
            </StackPanel>

            <StackPanel Margin="0,16,0,0">
                <TextBlock Text="{l:T free.choose}" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                <ItemsControl ItemsSource="{Binding Options}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,4" BorderBrush="{Binding Border}" Background="{Binding Background}"
                                    Cursor="Hand" MouseLeftButtonUp="Option_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="80"/>
                                    </Grid.ColumnDefinitions>
                                    <RadioButton GroupName="plan" IsChecked="{Binding IsChecked}" VerticalAlignment="Top" Margin="0,3,0,0" AutomationProperties.Name="{Binding Title}"/>
                                    <StackPanel Grid.Column="1" Margin="12,0">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource Secondary}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding Frees}" FontWeight="SemiBold" Foreground="{StaticResource Green}" TextAlignment="Right"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </DockPanel>
    </Border>
</v:DialogWindow>
