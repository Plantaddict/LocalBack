<UserControl x:Class="LocalBack.App.Views.SetsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:LocalBack.App.Controls"
             xmlns:l="clr-namespace:LocalBack.App.Localization">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Vis"/>
    </UserControl.Resources>
    <DockPanel Margin="28,24,28,24">
        <!-- Header -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,18">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Style="{StaticResource BtnSecondary}" Command="{Binding AddSet}">
                    <StackPanel Orientation="Horizontal">
                        <c:Icon Data="{StaticResource IconPlus}"/>
                        <TextBlock Text="{l:T btn.addSet}" Margin="8,0,0,0"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource BtnPrimary}" Command="{Binding BackUpAll}" Margin="8,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <c:Icon Data="{StaticResource IconBackUp}"/>
                        <TextBlock Text="{l:T btn.backUpAllNow}" Margin="8,0,0,0"/>
                    </StackPanel>
                </Button>
            </StackPanel>
            <StackPanel Margin="0,0,16,0">
                <TextBlock Text="{l:T sets.title}" Style="{StaticResource H1}"/>
                <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </DockPanel>

        <!-- Footer note -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Panel2}" CornerRadius="8" Padding="14,12" Margin="0,18,0,0">
            <DockPanel>
                <c:Icon DockPanel.Dock="Left" Data="{StaticResource IconInfo}" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Top" Margin="0,1,10,0"/>
                <TextBlock Text="{Binding Footer}" FontSize="13" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"/>
            </DockPanel>
        </Border>

        <Grid>
            <!-- Empty state -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding IsEmpty, Converter={StaticResource Vis}}">
                <Border Width="56" Height="56" CornerRadius="10" Background="{StaticResource AccentTint}" HorizontalAlignment="Center">
                    <c:Icon Data="{StaticResource IconFolder}" Width="28" Height="28" Foreground="{StaticResource Accent}" HorizontalAlignment="Center"/>
                </Border>
                <TextBlock Text="{l:T sets.empty.title}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,4"/>
                <TextBlock Text="{l:T sets.empty.text}" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="420"/>
                <Button Style="{StaticResource BtnPrimary}" Command="{Binding AddSet}" Margin="0,16,0,0" HorizontalAlignment="Center" Content="{l:T sets.empty.button}"/>
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,10" ToolTip="{Binding Tooltip}">
                                <Border.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="{l:T menu.backUpNow}" Command="{Binding BackUp}"/>
                                        <MenuItem Header="{l:T menu.history}" Command="{Binding Restore}"/>
                                        <MenuItem Header="{l:T menu.openFolder}" Command="{Binding ShowFolder}"/>
                                        <Separator/>
                                        <MenuItem Header="{l:T menu.unlock}" Command="{Binding Unlock}" Visibility="{Binding IsLocked, Converter={StaticResource Vis}}"/>
                                        <MenuItem Header="{l:T menu.forgetPassword}" Command="{Binding ForgetPassword}"/>
                                        <MenuItem Header="{Binding ToggleEnabledText}" Command="{Binding ToggleEnabled}"/>
                                        <MenuItem Header="{l:T menu.edit}" Command="{Binding Edit}"/>
                                        <MenuItem Header="{l:T menu.remove}" Command="{Binding Remove}"/>
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="40" Height="40" CornerRadius="8" Background="{StaticResource AccentTint}">
                                        <c:Icon Data="{StaticResource IconFolder}" Width="20" Height="20" Foreground="{StaticResource Accent}" HorizontalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Path}" Style="{StaticResource Secondary}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,14,0">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Style="{StaticResource Dot}" Fill="{Binding Dot}"/>
                                            <TextBlock Text="{Binding Status}" FontSize="12" Margin="6,0,0,0"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding When}" Style="{StaticResource Secondary}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="0,0,14,0">
                                        <TextBlock Text="{Binding Size}" FontSize="12"/>
                                        <TextBlock Text="{Binding Versions}" Style="{StaticResource Secondary}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource BtnSecondarySm}" Content="{l:T btn.backUp}" Command="{Binding BackUp}"
                                                Visibility="{Binding CanBackUp, Converter={StaticResource Vis}}"/>
                                        <Button Style="{StaticResource BtnSecondarySm}" Content="{l:T btn.unlock}" Command="{Binding Unlock}"
                                                Visibility="{Binding IsLocked, Converter={StaticResource Vis}}"/>
                                        <Button Style="{StaticResource BtnOutlineSm}" Content="{l:T btn.restore}" Command="{Binding Restore}" Margin="6,0,0,0"/>
                                        <Button Style="{StaticResource BtnIcon}" Margin="2,0,-8,0" ToolTip="{l:T btn.more}" AutomationProperties.Name="{l:T btn.more}"
                                                Click="More_Click">
                                            <TextBlock Text="⋯" FontSize="16" Margin="0,-4,0,0"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</UserControl>
