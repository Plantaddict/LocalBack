<UserControl x:Class="LocalBack.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24" MaxWidth="620" HorizontalAlignment="Left">
            <TextBlock Text="Settings" Style="{StaticResource H1}" Margin="0,0,0,18"/>

            <TextBlock Text="General" Style="{StaticResource Label}"/>
            <Border Style="{StaticResource Card}" Margin="0,0,0,18">
                <StackPanel>
                    <CheckBox Content="Start LocalBack when I sign in to Windows" IsChecked="{Binding StartWithWindows}"/>
                    <CheckBox Content="Show &quot;LocalBack versions&quot; when right-clicking a file in Explorer" IsChecked="{Binding ExplorerMenu}" Margin="0,10,0,0"/>
                    <CheckBox Content="On battery, back up live changes at most every 15 minutes" IsChecked="{Binding ThrottleOnBattery}" Margin="0,10,0,0"/>
                    <DockPanel Margin="0,12,0,0">
                        <ComboBox DockPanel.Dock="Right" Width="100" ItemsSource="{Binding Hours}" SelectedItem="{Binding DailyCheck}"
                                  AutomationProperties.Name="Daily check time"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Daily full check" FontSize="13"/>
                            <TextBlock Text="Compares every file's size and date with the backup, to catch anything missed." Style="{StaticResource Secondary}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="Version retention" Style="{StaticResource Label}"/>
            <Border Style="{StaticResource Card}" Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Text="When a backup drive is almost full, old copies are thinned with this plan. The newest version of every file is always kept."
                               Style="{StaticResource Secondary}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <ItemsControl ItemsSource="{Binding RetentionChoices}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <RadioButton GroupName="retention" IsChecked="{Binding IsChecked}" Margin="0,6,0,0">
                                    <StackPanel Margin="4,0,0,0">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13"/>
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource Secondary}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </RadioButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <CheckBox Content="Do this automatically when space is low (otherwise ask first)" IsChecked="{Binding AutoFreeSpace}" Margin="0,12,0,0"/>
                </StackPanel>
            </Border>

            <TextBlock Text="Pause" Style="{StaticResource Label}"/>
            <Border Style="{StaticResource Card}" Margin="0,0,0,18">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource BtnSecondarySm}" Content="{Binding PauseButton}" Command="{Binding TogglePause}"/>
                    <TextBlock Text="{Binding PauseText}" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"/>
                </DockPanel>
            </Border>

            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource BtnLinkSm}" Content="Open log folder" Command="{Binding OpenLogs}"/>
                <TextBlock Text="{Binding Version}" Style="{StaticResource Secondary}" VerticalAlignment="Center"/>
            </DockPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
