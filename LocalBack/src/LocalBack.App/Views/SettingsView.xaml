<UserControl x:Class="LocalBack.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:LocalBack.App.Localization">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24" MaxWidth="620" HorizontalAlignment="Left">
            <TextBlock Text="{l:T settings.title}" Style="{StaticResource H1}" Margin="0,0,0,18"/>

            <TextBlock Text="{l:T settings.general}" Style="{StaticResource Label}"/>
            <Border Style="{StaticResource Card}" Margin="0,0,0,18">
                <StackPanel>
                    <DockPanel Margin="0,0,0,12">
                        <ComboBox DockPanel.Dock="Right" Width="160" ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}" DisplayMemberPath="Name"
                                  AutomationProperties.Name="{l:T settings.language}"/>
                        <TextBlock Text="{l:T settings.language}" FontSize="13" VerticalAlignment="Center"/>
                    </DockPanel>
                    <CheckBox IsChecked="{Binding StartWithWindows}"><TextBlock Text="{l:T settings.startWithWindows}" TextWrapping="Wrap"/></CheckBox>
                    <CheckBox IsChecked="{Binding ExplorerMenu}" Margin="0,10,0,0"><TextBlock Text="{l:T settings.explorerMenu}" TextWrapping="Wrap"/></CheckBox>
                    <CheckBox IsChecked="{Binding ThrottleOnBattery}" Margin="0,10,0,0"><TextBlock Text="{l:T settings.battery}" TextWrapping="Wrap"/></CheckBox>
                    <DockPanel Margin="0,12,0,0">
                        <ComboBox DockPanel.Dock="Right" Width="100" ItemsSource="{Binding Hours}" SelectedItem="{Binding DailyCheck}"
                                  AutomationProperties.Name="{l:T settings.dailyCheck}"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{l:T settings.dailyCheck}" FontSize="13"/>
                            <TextBlock Text="{l:T settings.dailyCheckHint}" Style="{StaticResource Secondary}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="{l:T settings.retention}" Style="{StaticResource Label}"/>
            <Border Style="{StaticResource Card}" Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Text="{l:T settings.retentionIntro}" Style="{StaticResource Secondary}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <ItemsControl ItemsSource="{Binding RetentionChoices}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <RadioButton GroupName="retention" IsChecked="{Binding IsChecked}" Margin="0,6,0,0">
                                    <StackPanel Margin="4,0,0,0">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13"/>
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource Secondary}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </RadioButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <CheckBox IsChecked="{Binding AutoFreeSpace}" Margin="0,12,0,0"><TextBlock Text="{l:T settings.autoFree}" TextWrapping="Wrap"/></CheckBox>
                </StackPanel>
            </Border>

            <TextBlock Text="{l:T settings.pause}" Style="{StaticResource Label}"/>
            <Border Style="{StaticResource Card}" Margin="0,0,0,18">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource BtnSecondarySm}" Content="{Binding PauseButton}" Command="{Binding TogglePause}"/>
                    <TextBlock Text="{Binding PauseText}" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"/>
                </DockPanel>
            </Border>

            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource BtnLinkSm}" Content="{l:T settings.openLogs}" Command="{Binding OpenLogs}"/>
                <TextBlock Text="{Binding Version}" Style="{StaticResource Secondary}" VerticalAlignment="Center"/>
            </DockPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
