<Window x:Class="LocalBack.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:LocalBack.App.Controls"
        xmlns:l="clr-namespace:LocalBack.App.Localization"
        xmlns:vm="clr-namespace:LocalBack.App.ViewModels"
        xmlns:v="clr-namespace:LocalBack.App.Views"
        Title="{Binding Title}" Width="900" Height="600" MinWidth="760" MinHeight="480"
        WindowStartupLocation="CenterScreen" Icon="pack://application:,,,/LocalBack;component/Assets/LocalBack.ico"
        FontFamily="{StaticResource UiFont}" FontSize="14" Foreground="{StaticResource Text}"
        Background="{StaticResource Surface}" UseLayoutRounding="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="8" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:SetsViewModel}"><v:SetsView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:HistoryViewModel}"><v:HistoryView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:DrivesViewModel}"><v:DrivesView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><v:SettingsView/></DataTemplate>
        <BooleanToVisibilityConverter x:Key="Vis"/>
    </Window.Resources>

    <Border x:Name="RootFrame" BorderBrush="{StaticResource BorderStrong}" BorderThickness="1">
        <DockPanel>
            <!-- Title bar -->
            <Border DockPanel.Dock="Top" Height="36" Background="{StaticResource Panel2}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Style="{StaticResource Caption}" WindowChrome.IsHitTestVisibleInChrome="True" Click="Minimize_Click" ToolTip="{l:T win.minimize}" AutomationProperties.Name="{l:T win.minimize}">
                            <Path Data="M0,5 H10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" Width="10" Height="10"/>
                        </Button>
                        <Button Style="{StaticResource Caption}" WindowChrome.IsHitTestVisibleInChrome="True" Click="Maximize_Click" ToolTip="{l:T win.maximize}" AutomationProperties.Name="{l:T win.maximize}">
                            <Rectangle Width="10" Height="10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1"/>
                        </Button>
                        <Button Style="{StaticResource CaptionClose}" WindowChrome.IsHitTestVisibleInChrome="True" Click="Close_Click" ToolTip="{l:T win.close}" AutomationProperties.Name="{l:T win.close}">
                            <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" Width="10" Height="10"/>
                        </Button>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                        <c:Icon Data="{StaticResource IconLogo}" Foreground="{StaticResource Accent}"/>
                        <TextBlock Text="{Binding Title}" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Navigation -->
                <Border Width="196" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,1,0"
                        Visibility="{Binding ShowNav, Converter={StaticResource Vis}}">
                    <DockPanel Margin="8,12">
                        <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="12"
                                Visibility="{Binding HasDrive, Converter={StaticResource Vis}}">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Left" Text="{l:T drive.label}" Style="{StaticResource Secondary}"/>
                                    <TextBlock Text="{Binding DriveName}" FontSize="12" FontWeight="SemiBold" TextAlignment="Right" TextTrimming="CharacterEllipsis" Margin="8,0,0,0"/>
                                </DockPanel>
                                <ProgressBar Height="6" Margin="0,6" Value="{Binding DriveUsedPercent, Mode=OneWay}" Maximum="100"
                                             Foreground="{StaticResource Accent}" Background="{StaticResource Border}" BorderThickness="0">
                                    <ProgressBar.Template>
                                        <ControlTemplate TargetType="ProgressBar">
                                            <Border CornerRadius="3" Background="{TemplateBinding Background}" ClipToBounds="True">
                                                <Grid>
                                                    <Border x:Name="PART_Track"/>
                                                    <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="3"/>
                                                </Grid>
                                            </Border>
                                        </ControlTemplate>
                                    </ProgressBar.Template>
                                </ProgressBar>
                                <TextBlock Text="{Binding DriveFreeText}" Style="{StaticResource Secondary}"/>
                            </StackPanel>
                        </Border>
                        <StackPanel>
                            <RadioButton Style="{StaticResource NavItem}" IsChecked="{Binding IsSets}" GroupName="nav">
                                <StackPanel Orientation="Horizontal">
                                    <c:Icon Data="{StaticResource IconFolder}" Width="18" Height="18"/>
                                    <TextBlock Text="{l:T nav.sets}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource NavItem}" IsChecked="{Binding IsHistory}" GroupName="nav" Margin="0,2,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <c:Icon Data="{StaticResource IconClock}" Width="18" Height="18"/>
                                    <TextBlock Text="{l:T nav.history}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource NavItem}" IsChecked="{Binding IsDrives}" GroupName="nav" Margin="0,2,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <c:Icon Data="{StaticResource IconDrive}" Width="18" Height="18"/>
                                    <TextBlock Text="{l:T nav.drives}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource NavItem}" IsChecked="{Binding IsSettings}" GroupName="nav" Margin="0,2,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <c:Icon Data="{StaticResource IconSettings}" Width="18" Height="18"/>
                                    <TextBlock Text="{l:T nav.settings}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <ContentControl Grid.Column="1" Content="{Binding Current}" Focusable="False"/>
            </Grid>
        </DockPanel>
    </Border>
</Window>
